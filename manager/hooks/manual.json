{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/manager/src/agent_pm/manager/rearm.py\" --mode manual",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
