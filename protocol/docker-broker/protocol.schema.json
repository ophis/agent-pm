{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docker broker protocol 6",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
    },
    "session_name": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "const": "none"
      }
    },
    "generation": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^[0-9a-f]{32}$"
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^agent-pm-worker:[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "container": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^agent-pm-[A-Za-z0-9_-]+-[0-9a-f]{32}$"
    },
    "workspace": {
      "type": "string",
      "pattern": "^agent-pm-ws-[A-Za-z0-9_-]+$"
    },
    "github": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "app": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            }
          },
          "required": [
            "app"
          ],
          "additionalProperties": false
        }
      ]
    },
    "volume": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      ],
      "pattern": "^unix:///[^\\u0000-\\u001f\\u007f]+/\\.docker/run/docker\\.sock$"
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "allOf": [
          {
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          }
        ],
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "not": {
          "pattern": "^agent-pm\\."
        }
      },
      "additionalProperties": {
        "type": "string",
        "not": {
          "pattern": "[\\u0000-\\u001f\\u007f]"
        }
      }
    },
    "manifest": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/session_name"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "cwd": {
          "$ref": "#/$defs/path"
        },
        "workspace": {
          "$ref": "#/$defs/workspace"
        },
        "claude_dir": {
          "$ref": "#/$defs/path"
        },
        "github": {
          "$ref": "#/$defs/github"
        },
        "hook_path": {
          "$ref": "#/$defs/path"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      },
      "required": [
        "name",
        "generation",
        "image",
        "cwd",
        "workspace",
        "claude_dir",
        "github",
        "labels"
      ],
      "additionalProperties": false
    },
    "version_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "version"
            }
          ],
          "items": false,
          "minItems": 1
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "version_output": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "7"
        }
      },
      "required": [
        "protocol_version"
      ],
      "additionalProperties": false
    },
    "build_input": {
      "type": "object",
      "properties": {
        "argv": {
          "$comment": "Then any --plugin NAME pairs, then an optional --max-age SECONDS; JSON Schema cannot pair repeated tokens, so the broker checks the order (usage).",
          "type": "array",
          "prefixItems": [
            {
              "const": "build"
            },
            {
              "const": "--agent-pm"
            },
            {
              "$ref": "#/$defs/path"
            }
          ],
          "items": {
            "anyOf": [
              {
                "enum": [
                  "--plugin",
                  "--max-age"
                ]
              },
              {
                "$ref": "#/$defs/plugin"
              }
            ]
          },
          "minItems": 3,
          "anyOf": [
            {
              "maxItems": 3
            },
            {
              "minItems": 5
            }
          ]
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "build_output": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "rebuilt": {
          "type": "boolean"
        }
      },
      "required": [
        "image",
        "digest",
        "rebuilt"
      ],
      "additionalProperties": false
    },
    "start_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "start"
            },
            {
              "const": "--manifest"
            },
            {
              "$ref": "#/$defs/path"
            }
          ],
          "items": false,
          "minItems": 3
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "start_output": {
      "type": "object",
      "properties": {
        "container": {
          "$ref": "#/$defs/container"
        },
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "image_digest": {
          "$ref": "#/$defs/digest"
        },
        "clients": {
          "type": "object",
          "properties": {
            "claude": {
              "$ref": "#/$defs/text"
            },
            "codex": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "claude",
            "codex"
          ],
          "additionalProperties": false
        },
        "github": {
          "$ref": "#/$defs/expiries"
        }
      },
      "required": [
        "container",
        "endpoint",
        "image_digest",
        "clients",
        "github"
      ],
      "additionalProperties": false
    },
    "close_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "close"
            },
            {
              "const": "--container"
            },
            {
              "$ref": "#/$defs/container"
            }
          ],
          "items": false,
          "minItems": 3
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "close_output": {
      "type": "object",
      "properties": {
        "container": {
          "$ref": "#/$defs/container"
        },
        "removed": {
          "type": "boolean"
        }
      },
      "required": [
        "container",
        "removed"
      ],
      "additionalProperties": false
    },
    "workspace_rm_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "workspace-rm"
            },
            {
              "const": "--volume"
            },
            {
              "$ref": "#/$defs/volume"
            },
            {
              "const": "--force"
            }
          ],
          "items": false,
          "minItems": 3
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "workspace_rm_output": {
      "type": "object",
      "properties": {
        "volume": {
          "$ref": "#/$defs/volume"
        },
        "removed": {
          "type": "boolean"
        }
      },
      "required": [
        "volume",
        "removed"
      ],
      "additionalProperties": false
    },
    "refresh_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "refresh"
            },
            {
              "const": "--container"
            },
            {
              "$ref": "#/$defs/container"
            },
            {
              "const": "--manifest"
            },
            {
              "$ref": "#/$defs/path"
            }
          ],
          "items": false,
          "minItems": 5
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "refresh_output": {
      "type": "object",
      "properties": {
        "container": {
          "$ref": "#/$defs/container"
        },
        "github": {
          "$ref": "#/$defs/expiries"
        }
      },
      "required": [
        "container",
        "github"
      ],
      "additionalProperties": false
    },
    "status_input": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "status"
            }
          ],
          "items": false,
          "minItems": 1
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "status_output": {
      "type": "object",
      "properties": {
        "revocations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "container": {
                "$ref": "#/$defs/container"
              },
              "account": {
                "$ref": "#/$defs/github_login"
              },
              "expires_at": {
                "$ref": "#/$defs/time"
              }
            },
            "required": [
              "container",
              "account",
              "expires_at"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "revocations"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "error": {
          "type": "object",
          "properties": {
            "command": {
              "enum": [
                "version",
                "build",
                "start",
                "refresh",
                "close",
                "status",
                "workspace-rm",
                "unknown"
              ]
            },
            "code": {
              "enum": [
                "usage",
                "manifest_rejected",
                "mount_rejected",
                "login_required",
                "image_rejected",
                "docker_unreachable",
                "build_failed",
                "start_failed",
                "close_failed",
                "keychain_failed",
                "workspace_dirty",
                "workspace_rejected",
                "workspace_failed",
                "github_failed",
                "refresh_failed",
                "internal_error"
              ]
            },
            "message": {
              "$ref": "#/$defs/text"
            },
            "cleanup": {
              "enum": [
                "not_needed",
                "removed",
                "failed"
              ]
            },
            "cause": {
              "$ref": "#/$defs/text"
            },
            "cleanup_error": {
              "$ref": "#/$defs/text"
            },
            "container": {
              "$ref": "#/$defs/container"
            }
          },
          "required": [
            "command",
            "code",
            "message",
            "cleanup"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "cleanup": {
                    "const": "failed"
                  }
                }
              },
              "then": {
                "required": [
                  "cleanup_error",
                  "container"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "cleanup_error"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "command": {
                    "not": {
                      "const": "start"
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "cleanup": {
                    "const": "not_needed"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "exit_code",
        "error"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "exit_code": {
              "const": 2
            },
            "error": {
              "properties": {
                "code": {
                  "const": "usage"
                },
                "command": {
                  "enum": [
                    "version",
                    "build",
                    "start",
                    "refresh",
                    "close",
                    "status",
                    "workspace-rm",
                    "unknown"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 3
            },
            "error": {
              "properties": {
                "code": {
                  "const": "manifest_rejected"
                },
                "command": {
                  "enum": [
                    "start",
                    "refresh"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 4
            },
            "error": {
              "properties": {
                "code": {
                  "const": "mount_rejected"
                },
                "command": {
                  "enum": [
                    "start"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 5
            },
            "error": {
              "properties": {
                "code": {
                  "const": "login_required"
                },
                "command": {
                  "enum": [
                    "start",
                    "refresh"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 6
            },
            "error": {
              "properties": {
                "code": {
                  "const": "image_rejected"
                },
                "command": {
                  "enum": [
                    "start"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 7
            },
            "error": {
              "properties": {
                "code": {
                  "const": "docker_unreachable"
                },
                "command": {
                  "enum": [
                    "build",
                    "start",
                    "refresh",
                    "close",
                    "workspace-rm"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 8
            },
            "error": {
              "properties": {
                "code": {
                  "const": "build_failed"
                },
                "command": {
                  "enum": [
                    "build"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 9
            },
            "error": {
              "properties": {
                "code": {
                  "const": "start_failed"
                },
                "command": {
                  "enum": [
                    "start"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 10
            },
            "error": {
              "properties": {
                "code": {
                  "const": "close_failed"
                },
                "command": {
                  "enum": [
                    "close"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 11
            },
            "error": {
              "properties": {
                "code": {
                  "const": "keychain_failed"
                },
                "command": {
                  "enum": [
                    "start",
                    "refresh",
                    "close",
                    "status"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 12
            },
            "error": {
              "properties": {
                "code": {
                  "const": "workspace_dirty"
                },
                "command": {
                  "enum": [
                    "workspace-rm"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 13
            },
            "error": {
              "properties": {
                "code": {
                  "const": "workspace_rejected"
                },
                "command": {
                  "enum": [
                    "workspace-rm"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 14
            },
            "error": {
              "properties": {
                "code": {
                  "const": "workspace_failed"
                },
                "command": {
                  "enum": [
                    "workspace-rm"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 15
            },
            "error": {
              "properties": {
                "code": {
                  "const": "github_failed"
                },
                "command": {
                  "enum": [
                    "start",
                    "refresh"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 16
            },
            "error": {
              "properties": {
                "code": {
                  "const": "refresh_failed"
                },
                "command": {
                  "enum": [
                    "refresh"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 70
            },
            "error": {
              "properties": {
                "code": {
                  "const": "internal_error"
                },
                "command": {
                  "enum": [
                    "version",
                    "build",
                    "start",
                    "refresh",
                    "close",
                    "status",
                    "workspace-rm",
                    "unknown"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "github_login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expiries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/$defs/github_login"
          },
          "expires_at": {
            "$ref": "#/$defs/time"
          }
        },
        "required": [
          "account",
          "expires_at"
        ],
        "additionalProperties": false
      }
    },
    "plugin": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(@[A-Za-z0-9][A-Za-z0-9._-]*)?$"
    }
  }
}
