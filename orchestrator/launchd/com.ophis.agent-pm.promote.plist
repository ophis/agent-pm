<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AGENT_PM_BOARD_DIR</key>
		<string>@BOARD@</string>
		<key>PATH</key>
		<string>@PATH@</string>
	</dict>
	<key>Label</key>
	<string>com.ophis.agent-pm.promote</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.agent-pm/bin/agent-pm-orchestrator</string>
		<string>promote</string>
	</array>
	<key>StandardErrorPath</key>
	<string>@HOME@/.agent-pm/logs/orchestrator.jsonl</string>
	<key>StandardOutPath</key>
	<string>@HOME@/.agent-pm/logs/orchestrator.jsonl</string>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
