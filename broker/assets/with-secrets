#!/opt/agent-pm/venv/bin/python
import os
import sys

with open("/run/agent-pm/secrets/claude", encoding="utf-8") as stream:
    token = stream.read()
if not token or not sys.argv[1:]:
    sys.exit("with-secrets: token and command required")
os.execvpe(sys.argv[1], sys.argv[1:], {**os.environ, "CLAUDE_CODE_OAUTH_TOKEN": token})
