#!/opt/agent-pm/venv/bin/python
import os
import sys
from pathlib import Path

SECRET = Path("/run/agent-pm/secrets/claude")


def main(argv, secret=SECRET):
    if not argv:
        sys.exit("usage: with-secrets COMMAND [ARG...]")
    if os.environ.get("CODEX_HOME"):
        os.execvpe(argv[0], argv, os.environ)
    try:
        token = secret.read_text(encoding="utf-8").strip()
    except OSError:
        token = ""
    if not token:
        sys.exit("with-secrets: no Claude token in /run/agent-pm/secrets; start a new container")
    os.execvpe(argv[0], argv, {**os.environ, "CLAUDE_CODE_OAUTH_TOKEN": token})


if __name__ == "__main__":
    main(sys.argv[1:])
